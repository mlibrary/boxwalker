<h2 class="online-content-heading">
  Online content
  <span class="al-online-content-icon" aria-hidden="true"
        data-bs-toggle="tooltip" title="Includes Digital Content">
    <%= helpers.blacklight_icon(:online) %>
  </span>
</h2>
<div class="al-digital-objects">
  <% @document.digital_objects.each do |dao| %>
    <% embed_url   = helpers.quod_embed_url(dao.href) %>
    <% kaltura_url = embed_url ? nil : helpers.kaltura_embed_url(dao.href) %>
    <% label       = dao.label.presence %>

    <% if embed_url %>
      <%# Quod / DDR image viewer.
          <figure> groups the player with its link; the link text is deliberately
          different from the frame title so SR users can tell them apart. %>
      <figure class="al-digital-object">
        <iframe src="<%= embed_url %>"
                height="600"
                width="100%"
                allowfullscreen
                loading="lazy"
                class="ddr-embed-iframe ddr-image-service"
                style="border: 0;"
                title="<%= label || 'Embedded image viewer' %>"></iframe>
        <figcaption class="ddr-link-under">
          <%= link_to dao.href, target: "_blank", rel: "noopener noreferrer" do %>
            View item page, more info, and downloads
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
            <span class="visually-hidden">(opens in a new window)</span>
          <% end %>
        </figcaption>
      </figure>

    <% elsif kaltura_url %>
      <%# Kaltura: rendered server-side by VideoObjectHelper.
          No data-controller here, so upstream JS never touches Kaltura links.
          Frame title = item label; link = "<label> — view on MiVideo" so the
          two don't share an accessible name. %>
      <figure class="al-digital-object">
        <%= helpers.kaltura_iframe_tag(kaltura_url,
                                       title: label || 'Media player') %>
        <figcaption class="ddr-link-under">
          <%= link_to dao.href, target: "_blank", rel: "noopener noreferrer" do %>
            <% if label %>
              <%= label %> &mdash; view on MiVideo
            <% else %>
              View on MiVideo
            <% end %>
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
            <span class="visually-hidden">(opens in a new window)</span>
          <% end %>
        </figcaption>
      </figure>

    <% else %>
      <% oembed = helpers.oembed_html(dao.href) %>
      <% if oembed %>
        <%# Third-party oEmbed. We don't control its markup, but we can still
            group it with a link out so there's always a non-embedded path. %>
        <figure class="al-digital-object">
          <%= oembed %>
          <figcaption class="ddr-link-under">
            <%= link_to dao.href, target: "_blank", rel: "noopener noreferrer" do %>
              <% if label %>
                <%= label %> &mdash; view original
              <% else %>
                View original
              <% end %>
              <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
              <span class="visually-hidden">(opens in a new window)</span>
            <% end %>
          </figcaption>
        </figure>
      <% else %>
        <%# Plain link, no embed. No frame to disambiguate from, so no <figure>. %>
        <div class="al-digital-object">
          <%= link_to dao.href, target: "_blank", rel: "noopener noreferrer" do %>
            <%= label || dao.href %>
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
            <span class="visually-hidden">(opens in a new window)</span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>