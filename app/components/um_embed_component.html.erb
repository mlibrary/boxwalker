<h2 class="online-content-heading">
  Online content
  <span class="al-online-content-icon" aria-hidden="true"
        data-bs-toggle="tooltip" title="Includes Digital Content">
    <%= helpers.blacklight_icon(:online) %>
  </span>
</h2>
<div class="al-digital-objects">
  <% @document.digital_objects.each do |dao| %>
    <% embed_url   = helpers.quod_embed_url(dao.href) %>
    <% kaltura_url = embed_url ? nil : helpers.kaltura_embed_url(dao.href) %>

    <% if embed_url %>
      <%# Quod / DDR image viewer (unchanged) %>
      <div class="al-digital-object mb-4">
        <iframe src="<%= embed_url %>"
                height="600"
                width="100%"
                allowfullscreen
                loading="lazy"
                class="ddr-embed-iframe ddr-image-service"
                style="border: 0;"
                title="<%= dao.label.presence || 'Embedded image viewer' %>"></iframe>
        <div class="ddr-link-under">
          <%= link_to dao.href, target: "_blank", rel: "noopener" do %>
            <span>View Item Page / More Info / Download</span>
            <strong class="bi bi-box-arrow-up-right" aria-hidden="true"></strong>
            <span class="visually-hidden">(opens in new tab)</span>
          <% end %>
        </div>
      </div>

    <% elsif kaltura_url %>
      <%# Kaltura: rendered server-side by VideoObjectHelper.
          No data-controller here, so upstream JS never touches Kaltura links %>
      <div class="mb-2">
        <%= helpers.kaltura_iframe_tag(kaltura_url,
                                       title: dao.label.presence || 'Media player') %>
        <%# Original link kept as a fallback %>
        <div class="al-digital-object">
          <%= link_to (dao.label.presence || dao.href), dao.href,
                      target: "_blank", rel: "noopener" %>
        </div>
      </div>

    <% else %>
      <% oembed = helpers.oembed_html(dao.href) %>
      <div class="al-digital-object mb-2">
        <% if oembed %>
          <%= oembed %>
        <% else %>
          <%= link_to (dao.label.presence || dao.href), dao.href,
                      target: "_blank", rel: "noopener" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>