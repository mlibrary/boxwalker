<%= content_tag :li,
   id: "#{@document.id}-hierarchy-item",
   data: {
   'document-id': @document.id.to_s.parameterize,
   'document-counter': @counter, },
    itemscope: true,
    itemtype: @document.itemtype,
    class: (classes.flatten + ['al-collection-context', ('al-hierarchy-highlight' if
    current_target?)].compact).join(' ') do %>

  <div class="documentHeader" data-document-id="<%= document.id %>">
<% if document.children? %>
        <%= content_tag(
              :button,
              type: "button",
              class: "al-toggle-view-children#{' collapsed' unless show_expanded?}",
              aria: {
                label: t("um_arclight.hierarchy.toggle_children",
                         title: document.normalized_title,
                         default: "Show or hide components within %{title}"),
                expanded: show_expanded?,
                controls: "collapsible-hierarchy-#{document.id}"
              },
              data: { bs_toggle: "collapse", bs_target: "#collapsible-hierarchy-#{document.id}" }
            ) do %>
          <span class="al-toggle-icon" aria-hidden="true"></span>
        <% end %>
      <% end %>

  <div class="index_title document-title-heading" data-turbo="false">
    <% if current_target? || !helpers.is_interesting_component?(document) %>
      <%= document.normalized_title %>
    <% else %>
      <%= helpers.link_to_document document, counter: @counter %>
    <% end %>
    <% if document.children? %>
      <span class="badge badge-pill bg-secondary badge-secondary al-number-of-children-badge"><%= document.number_of_children %>
      <span class="sr-only visually-hidden"><%= t(:'arclight.views.index.number_of_components', count: document.number_of_children) %></span></span>
    <% end %>
    <%= online_status %>
    <%= render "catalog/restricted_component_badge", document: document %>
  </div>
    <%= content_tag('div', class: 'al-document-container text-muted') do %>
      <%= document.containers.join(', ') %>
    <% end if document.containers.present? %>
  </div>

  <%= render Arclight::IndexMetadataFieldComponent.with_collection(@presenter&.field_presenters.select { |field| field.field_config.collection_context }, classes: ['col pl-0 my-0']) %>
  <% if document.number_of_children > 0 %>
    <%= content_tag(:div, id: "collapsible-hierarchy-#{document.id}", class: "collapse al-collection-context-collapsible al-hierarchy-level-#{document.component_level} #{'show' if show_expanded?}") do %>
      <%= render Arclight::DocumentComponentsHierarchyComponent.new(document: @document, target_index: target_index) %>
    <% end %>
  <% end %>
<% end %>
