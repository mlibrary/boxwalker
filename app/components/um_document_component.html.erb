<div class="al-show-actions-toolbar sticky-toolbar-top">
  <%= render 'arclight/requests', document: document %>
</div>

<div class="al-repository-card">
  <%= render document.repository_config %>
</div>

<%= render breadcrumb_component.new(presenter: presenter) %>

<div class="title-container">
  <%= content_tag :h1 do %>
    <%= document.normalized_title %>
  <% end %>
  <%# UM customization: Removed Arclight::BookmarkComponent %>
  <%= toggle_sidebar %>
</div>

<% if document.collection? %>
  <%= digital_materials_filter %>
<% end %>

<%= render Arclight::MetadataSectionComponent.with_collection(component_metadata_partials,
  metadata_attr: { layout: UmUpperMetadataLayoutComponent },
  presenter: presenter, classes: "") unless document.collection? %>

<%= embed %>

<% if document.collection? %>
  <div id="metadata">
    <h2 class="sr-only visually-hidden"><%= t 'arclight.views.show.context' %></h2>
    <%= render UmAccessSnippetComponent.new(presenter: presenter) %>
    <%= render UmMetadataSectionComponent.with_collection(metadata_partials,
      metadata_attr: { layout: UmUpperMetadataLayoutComponent },
      presenter: presenter, heading: true, classes: "") %>
  </div>
<% end %>

<% if document.children? %>
  <div id="contents">
    <h2 class="al-show-sub-heading"><%= t 'arclight.views.show.contents' %></h2>
    <%= helpers.turbo_frame_tag(
      "al-hierarchy-#{document.id}-document",
      loading: 'lazy',
      src: helpers.hierarchy_solr_document_path(
        id: document.id, key: '-document', paginate: true, contents: true
      )
    ) %>
  </div>
<% end %>

<%= access %>
